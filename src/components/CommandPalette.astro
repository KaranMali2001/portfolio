---
import { personalInfo } from "../lib/portfolio-data";

// type drives the action the script runs; target is its argument.
const commands = [
  { label: "Go to top", group: "Navigate", type: "scroll", target: "top" },
  { label: "Engineering with AI", group: "Navigate", type: "scroll", target: "engineering-with-ai" },
  { label: "Experience", group: "Navigate", type: "scroll", target: "experience" },
  { label: "Projects", group: "Navigate", type: "scroll", target: "projects" },
  { label: "Writing", group: "Navigate", type: "scroll", target: "writing" },
  { label: "How I learn", group: "Navigate", type: "scroll", target: "learn" },
  { label: "Contact", group: "Navigate", type: "scroll", target: "contact" },
  { label: "What I'm doing now →", group: "Navigate", type: "nav", target: "/now" },
  { label: "GitHub", group: "Open", type: "external", target: personalInfo.github },
  { label: "Résumé", group: "Open", type: "external", target: personalInfo.resumeUrl },
  { label: "dev.to", group: "Open", type: "external", target: personalInfo.devto },
  { label: "Medium", group: "Open", type: "external", target: personalInfo.medium },
  { label: "X / Twitter", group: "Open", type: "external", target: personalInfo.x },
  { label: "Email me", group: "Actions", type: "mailto", target: personalInfo.email },
  { label: "Copy email address", group: "Actions", type: "copy", target: personalInfo.email },
];

const groups = ["Navigate", "Open", "Actions"].map((name) => ({
  name,
  items: commands.filter((c) => c.group === name),
}));
---

<div id="cmdk-root" class="cmdk-root" aria-hidden="true">
  <div class="cmdk-backdrop" data-close></div>

  <div
    class="cmdk-dialog z-50 w-full max-w-[520px]"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
  >
    <div
      class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-[0_24px_64px_rgba(0,0,0,0.18)]"
    >
      <div class="flex items-center border-b border-zinc-100 px-4">
        <svg
          class="mr-3 h-4 w-4 shrink-0 text-zinc-500"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          id="cmdk-input"
          type="text"
          placeholder="Search commands…"
          autocomplete="off"
          spellcheck="false"
          class="h-12 w-full bg-transparent font-sans text-[15px] text-zinc-900 placeholder:text-zinc-400 focus:outline-none"
        />
        <button
          data-close
          class="ml-2 shrink-0 rounded px-1.5 py-0.5 font-mono text-[11px] text-zinc-500 ring-1 ring-zinc-200 hover:text-zinc-600"
        >
          esc
        </button>
      </div>

      <div id="cmdk-list" class="max-h-[min(50vh,360px)] overflow-y-auto py-2">
        <p
          id="cmdk-empty"
          class="hidden py-8 text-center font-sans text-[14px] text-zinc-500"
        >
          No results.
        </p>
        {
          groups.map((g) => (
            <div class="cmdk-group" data-group={g.name}>
              <div class="px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-zinc-500">
                {g.name}
              </div>
              {g.items.map((c) => (
                <button
                  class="cmdk-item mx-2 flex w-[calc(100%-1rem)] cursor-pointer items-center justify-between rounded-lg px-3 py-2.5 text-left font-sans text-[14px] text-zinc-700 transition-colors"
                  data-value={c.label.toLowerCase()}
                  data-type={c.type}
                  data-target={c.target}
                >
                  {c.label}
                </button>
              ))}
            </div>
          ))
        }
      </div>

      <div
        class="border-t border-zinc-100 px-4 py-2.5 font-mono text-[11px] text-zinc-500"
      >
        <span id="cmdk-mod">⌘</span>K to open · ↑↓ to navigate · ↵ to run · esc to close
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById("cmdk-root")!;
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const empty = document.getElementById("cmdk-empty")!;
  const items = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".cmdk-item"),
  );
  const groupEls = Array.from(
    document.querySelectorAll<HTMLElement>(".cmdk-group"),
  );

  const isMac =
    typeof navigator !== "undefined" &&
    navigator.platform.toUpperCase().includes("MAC");
  const modEl = document.getElementById("cmdk-mod");
  if (modEl && !isMac) modEl.textContent = "Ctrl";

  let selected = -1;

  function visibleItems() {
    return items.filter((el) => !el.classList.contains("hidden"));
  }

  function setSelected(i: number) {
    const vis = visibleItems();
    vis.forEach((el) => el.classList.remove("is-selected"));
    if (!vis.length) {
      selected = -1;
      return;
    }
    selected = (i + vis.length) % vis.length;
    const el = vis[selected];
    el.classList.add("is-selected");
    el.scrollIntoView({ block: "nearest" });
  }

  function filter(q: string) {
    const query = q.trim().toLowerCase();
    items.forEach((el) => {
      const match = !query || el.dataset.value!.includes(query);
      el.classList.toggle("hidden", !match);
    });
    // Hide groups with no visible items.
    groupEls.forEach((g) => {
      const any = g.querySelector(".cmdk-item:not(.hidden)");
      g.classList.toggle("hidden", !any);
    });
    const vis = visibleItems();
    empty.classList.toggle("hidden", vis.length > 0);
    setSelected(0);
  }

  function open() {
    root.classList.add("is-open");
    root.setAttribute("aria-hidden", "false");
    input.value = "";
    filter("");
    setTimeout(() => input.focus(), 10);
  }

  function close() {
    root.classList.remove("is-open");
    root.setAttribute("aria-hidden", "true");
    input.value = "";
  }

  function scrollToId(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    // @ts-expect-error - Lenis handle stashed by Base.astro
    const lenis = window.__lenis;
    if (lenis) lenis.scrollTo(el, { offset: -64 });
    else el.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function run(el: HTMLButtonElement) {
    const { type, target } = el.dataset as { type: string; target: string };
    close();
    if (type === "scroll") setTimeout(() => scrollToId(target), 80);
    else if (type === "nav") location.href = target;
    else if (type === "external") window.open(target, "_blank");
    else if (type === "mailto") location.href = `mailto:${target}`;
    else if (type === "copy") navigator.clipboard?.writeText(target);
  }

  // ── Wiring ──
  input.addEventListener("input", () => filter(input.value));

  items.forEach((el) => {
    el.addEventListener("click", () => run(el));
    el.addEventListener("mousemove", () => {
      const vis = visibleItems();
      const i = vis.indexOf(el);
      if (i >= 0) setSelected(i);
    });
  });

  root.querySelectorAll("[data-close]").forEach((el) =>
    el.addEventListener("click", close),
  );

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      root.classList.contains("is-open") ? close() : open();
      return;
    }
    if (!root.classList.contains("is-open")) return;
    if (e.key === "Escape") {
      close();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      setSelected(selected + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setSelected(selected - 1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      const vis = visibleItems();
      if (vis[selected]) run(vis[selected]);
    }
  });

  window.addEventListener("open-command-palette", open);
</script>

---
import { personalInfo } from "../lib/portfolio-data";
import SectionLabel from "./SectionLabel.astro";
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";
import ULink from "./ULink.astro";

const year = new Date().getFullYear();
---

<section id="contact" class="py-14">
  <Divider class="mb-10" />
  <Reveal>
    <SectionLabel>Contact</SectionLabel>
    <p class="text-[18px] leading-relaxed text-zinc-600">
      {personalInfo.availability}. The fastest way to reach me is{" "}
      <ULink href={`mailto:${personalInfo.email}`} external={false}>
        {personalInfo.email}
      </ULink>.
    </p>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[18px]">
      <ULink href={personalInfo.github}>GitHub</ULink>
      <ULink href={personalInfo.devto}>dev.to</ULink>
      <ULink href={personalInfo.medium}>Medium</ULink>
      <ULink href={personalInfo.x}>X</ULink>
      <ULink href={personalInfo.website}>Website</ULink>
      <ULink href={personalInfo.resumeUrl}>Résumé</ULink>
    </div>
  </Reveal>
  <footer class="mt-12 pb-12 font-mono text-[13px] text-zinc-500">
    <p>© {year} {personalInfo.name} · {personalInfo.location}</p>
    <p class="mt-1">Built with Astro · Tailwind · Deployed on Vercel</p>
  </footer>
</section>

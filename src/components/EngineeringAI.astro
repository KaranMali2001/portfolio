---
import { engineeringWithAI } from "../lib/portfolio-data";
import SectionLabel from "./SectionLabel.astro";
import Reveal from "./Reveal.astro";
import ULink from "./ULink.astro";
import Tag from "./Tag.astro";

const TERM_GREEN = "rgba(34, 197, 94, 0.6)";
---

<section id="engineering-with-ai" class="py-14">
  <SectionLabel>Engineering with AI</SectionLabel>
  <div class="space-y-9">
    {
      engineeringWithAI.map((item) => (
        <Reveal>
          <div class="border-l-2 pl-4" style={`border-color:${TERM_GREEN}`}>
            <h3 class="flex items-baseline gap-2 text-[18px] font-semibold leading-snug text-zinc-900">
              <span
                class="shrink-0 font-mono text-[16px] font-normal leading-none"
                style={`color:${TERM_GREEN}`}
              >
                ›
              </span>
              <span class="min-w-0">
                {item.url ? (
                  <ULink href={item.url}>{item.headline}</ULink>
                ) : (
                  item.headline
                )}
              </span>
              {!item.url && (
                <span class="ml-auto shrink-0 rounded-full bg-accent/10 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-accent">
                  Coming soon
                </span>
              )}
            </h3>
            <p class="mt-2 text-[15px] leading-relaxed text-zinc-600">{item.what}</p>
            <p class="mt-2 text-[14px] leading-relaxed text-zinc-500">{item.proof}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.tech.map((t) => (
                <Tag label={t} />
              ))}
            </div>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>

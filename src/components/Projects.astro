---
import { projects } from "../lib/portfolio-data";
import SectionLabel from "./SectionLabel.astro";
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";
import Tag from "./Tag.astro";
---

<section id="projects" class="py-14">
  <Divider class="mb-10" />
  <SectionLabel>Projects</SectionLabel>
  <div class="space-y-10">
    {
      projects.map((p) => {
        const href = p.liveUrl ?? p.githubUrl ?? "#";
        const hasSource = p.githubUrl && p.liveUrl;
        return (
          <Reveal>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-[18px] font-semibold">
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative inline-flex items-baseline gap-1.5 text-zinc-900 transition-colors duration-200 hover:text-accent"
                >
                  <span>{p.title}</span>
                  {p.subtitle && (
                    <span class="font-normal text-zinc-500 group-hover:text-accent/60">
                      · {p.subtitle}
                    </span>
                  )}
                  <span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-accent transition-transform duration-200 ease-out group-hover:scale-x-100" />
                </a>
              </h3>
              <div class="flex shrink-0 items-center gap-2.5">
                {p.featured && (
                  <span class="rounded-full bg-accent/10 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-accent">
                    Featured
                  </span>
                )}
                {hasSource && (
                  <a
                    href={p.githubUrl!}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1 font-mono text-[13px] text-zinc-500 transition-colors duration-200 hover:text-accent"
                  >
                    Source
                    <svg
                      class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <ul class="mt-3 space-y-2">
              {[p.description, p.solution, p.impact].map((point) => (
                <li class="flex gap-3 text-[18px] leading-relaxed text-zinc-600">
                  <span class="mt-[10px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.tech.map((t) => (
                <Tag label={t} />
              ))}
            </div>
          </Reveal>
        );
      })
    }
  </div>
</section>

---
import { blogPosts } from "../lib/portfolio-data";
import SectionLabel from "./SectionLabel.astro";
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";
import ULink from "./ULink.astro";
import Tag from "./Tag.astro";
---

<section id="writing" class="py-14">
  <Divider class="mb-10" />
  <SectionLabel>Writing</SectionLabel>
  <div class="space-y-8">
    {
      blogPosts.map((post) => (
        <Reveal>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-[17px] font-semibold leading-snug text-zinc-900">
              {post.url ? <ULink href={post.url}>{post.title}</ULink> : post.title}
            </h3>
            <span class="font-mono text-[13px] text-zinc-500">{post.publishedDate}</span>
          </div>
          <p class="mt-2 text-[18px] leading-relaxed text-zinc-500">{post.excerpt}</p>
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            <span class="font-mono text-[13px] text-zinc-500">
              {post.platform} · {post.readTime}
              {post.upcoming ? " · in progress" : ""}
            </span>
            {post.tags.map((tag) => (
              <Tag label={tag} />
            ))}
          </div>
        </Reveal>
      ))
    }
  </div>
</section>

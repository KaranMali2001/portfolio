---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import EngineeringAI from "../components/EngineeringAI.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Writing from "../components/Writing.astro";
import Learn from "../components/Learn.astro";
import Contact from "../components/Contact.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { personalInfo } from "../lib/portfolio-data";

const title = "Karan Mali — Backend + Product Engineer";
const description =
  "Backend & product engineer working on data integrity, multi-tenant architecture, and AI tooling. Currently at Ajar. Open to backend & product roles.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateCreated: "2024-01-01T00:00:00Z",
  dateModified: new Date().toISOString(),
  mainEntity: {
    "@id": "#karan-mali",
    "@type": "Person",
    name: personalInfo.name,
    alternateName: personalInfo.githubUsername,
    description:
      "Backend & Product Engineer working on data integrity, multi-tenant architecture, and AI tooling. Currently at Ajar. Open to backend & product roles.",
    image: {
      "@type": "ImageObject",
      url: `${personalInfo.website}/avatar.jpg`,
    },
    url: personalInfo.website,
    sameAs: [
      personalInfo.github,
      personalInfo.devto,
      personalInfo.medium,
      personalInfo.x,
    ],
  },
};
---

<Base title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />

  <div class="scroll-progress" aria-hidden="true"></div>

  <main id="main-content" tabindex="-1" class="min-h-screen bg-[#F5EFE6] text-zinc-900">
    <div class="mx-auto max-w-[720px] px-5">
      <Nav />
      <Hero />
      <EngineeringAI />
      <Experience />
      <Writing />
      <Projects />
      <Learn />
      <Contact />
    </div>
  </main>

  <CommandPalette />
</Base>

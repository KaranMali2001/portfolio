---
// SCRATCH comparison page — renders the Writing list in 4 candidate styles so
// they can be compared live. Delete once a direction is chosen.
import Base from "../layouts/Base.astro";
import { blogPosts } from "../lib/portfolio-data";
import Tag from "../components/Tag.astro";
import ULink from "../components/ULink.astro";

const meta = (p: (typeof blogPosts)[number]) =>
  `${p.platform}${p.readTime && p.readTime !== "—" ? ` · ${p.readTime}` : ""}`;
const when = (p: (typeof blogPosts)[number]) =>
  p.upcoming ? "Coming soon" : p.publishedDate;
const featured = blogPosts[0];
const rest = blogPosts.slice(1);
---

<Base title="Writing styles" description="scratch comparison">
  <main class="min-h-screen bg-[#F5EFE6] py-16 text-zinc-900">
    <div class="mx-auto max-w-[720px] space-y-20 px-5">
      <p class="font-mono text-[12px] uppercase tracking-[0.2em] text-zinc-400">
        Scratch page · compare Writing styles
      </p>

      {/* ── 1 · NUMBERED INDEX ─────────────────────────────────────────── */}
      <section>
        <h2 class="mb-8 font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
          Option 1 — Numbered index
        </h2>
        <div class="space-y-6">
          {blogPosts.map((post, i) => (
            <div class="flex gap-4">
              <span class="shrink-0 pt-1 font-mono text-[13px] tabular-nums text-accent/70">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="min-w-0 text-[17px] font-semibold leading-snug text-zinc-900">
                    {post.url ? <ULink href={post.url}>{post.title}</ULink> : post.title}
                  </h3>
                  <span class={`shrink-0 whitespace-nowrap font-mono text-[13px] ${post.upcoming ? "text-accent" : "text-zinc-500"}`}>
                    {when(post)}
                  </span>
                </div>
                <p class="mt-1.5 text-[15px] leading-relaxed text-zinc-500">{post.excerpt}</p>
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  <span class="font-mono text-[13px] text-zinc-500">{meta(post)}</span>
                  {post.tags.map((t) => <Tag label={t} />)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* ── 2 · METADATA GUTTER ────────────────────────────────────────── */}
      <section>
        <h2 class="mb-8 font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
          Option 2 — Metadata gutter
        </h2>
        <div class="space-y-6">
          {blogPosts.map((post) => (
            <div class="flex gap-4 sm:gap-5">
              <div class="w-[92px] shrink-0 border-r border-black/10 pr-4 text-right font-mono text-[12px] leading-[1.7] text-zinc-500">
                <div class={post.upcoming ? "text-accent" : "text-zinc-600"}>{when(post)}</div>
                <div>{post.platform}</div>
                {post.readTime && post.readTime !== "—" && <div>{post.readTime}</div>}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-[17px] font-semibold leading-snug text-zinc-900">
                  {post.url ? <ULink href={post.url}>{post.title}</ULink> : post.title}
                </h3>
                <p class="mt-1.5 text-[15px] leading-relaxed text-zinc-500">{post.excerpt}</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {post.tags.map((t) => <Tag label={t} />)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* ── 3 · TIMELINE ───────────────────────────────────────────────── */}
      <section>
        <h2 class="mb-8 font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
          Option 3 — Timeline
        </h2>
        <div class="space-y-7">
          {blogPosts.map((post, i) => (
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <span class="mt-[7px] h-2.5 w-2.5 shrink-0 rounded-full border-2 border-accent bg-[#F5EFE6]" />
                {i < blogPosts.length - 1 && <span class="mt-1 w-px flex-1 bg-black/10" />}
              </div>
              <div class="min-w-0 flex-1 pb-1">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="min-w-0 text-[17px] font-semibold leading-snug text-zinc-900">
                    {post.url ? <ULink href={post.url}>{post.title}</ULink> : post.title}
                  </h3>
                  <span class={`shrink-0 whitespace-nowrap font-mono text-[13px] ${post.upcoming ? "text-accent" : "text-zinc-500"}`}>
                    {when(post)}
                  </span>
                </div>
                <p class="mt-1.5 text-[15px] leading-relaxed text-zinc-500">{post.excerpt}</p>
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  <span class="font-mono text-[13px] text-zinc-500">{meta(post)}</span>
                  {post.tags.map((t) => <Tag label={t} />)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* ── 4 · FEATURED + COMPACT ─────────────────────────────────────── */}
      <section>
        <h2 class="mb-8 font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
          Option 4 — Featured + compact
        </h2>
        <div class="border-l-2 border-accent pl-4">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="min-w-0 text-[18px] font-semibold leading-snug text-zinc-900">
              {featured.url ? <ULink href={featured.url}>{featured.title}</ULink> : featured.title}
            </h3>
            <span class={`shrink-0 whitespace-nowrap font-mono text-[13px] ${featured.upcoming ? "text-accent" : "text-zinc-500"}`}>
              {when(featured)}
            </span>
          </div>
          <p class="mt-2 text-[15px] leading-relaxed text-zinc-500">{featured.excerpt}</p>
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            <span class="font-mono text-[13px] text-zinc-500">{meta(featured)}</span>
            {featured.tags.map((t) => <Tag label={t} />)}
          </div>
        </div>
        <div class="mt-4 border-t border-black/10">
          {rest.map((post) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-black/10 py-3">
              <h3 class="min-w-0 truncate text-[15px] font-medium text-zinc-800">
                {post.url ? <ULink href={post.url}>{post.title}</ULink> : post.title}
              </h3>
              <span class={`shrink-0 whitespace-nowrap font-mono text-[13px] ${post.upcoming ? "text-accent" : "text-zinc-500"}`}>
                {when(post)}
              </span>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Base>
